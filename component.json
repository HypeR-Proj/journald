        "/dependencies/serde_json": {
          "workspace": true
        },
        "/dependencies/hyper-service": {
          "workspace": true
        },
        "/dependencies/hyper-component": {
          "workspace": true
        },
        "/dependencies/hyper-journal": {
          "workspace": true
        }
      }
    }
