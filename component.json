    "src/lib.rs": "svc/journal/src/lib.rs",
    "src/main.rs": "svc/journal/src/main.rs",
    "tests/batch.rs": "svc/journal/tests/batch.rs",
    "tests/retention.rs": "svc/journal/tests/retention.rs",
    "tests/throughput.rs": "svc/journal/tests/throughput.rs"
  },
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "mounts": {
    "": "svc/journal"
  },
  "packages": [
